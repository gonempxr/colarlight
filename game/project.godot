; Engine configuration file.
config_version=5

[application]

config/name="Coralight"
config/description="Idle tycoon: divers, a boat and a plant under the sea."
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Profiles="*res://scripts/autoload/profiles.gd"
Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"
GameState="*res://scripts/autoload/game_state.gd"
Progress="*res://scripts/autoload/progress.gd"
Platform="*res://scripts/autoload/platform.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=false

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.ru.translation", "res://i18n/strings.es.translation", "res://i18n/strings.zh.translation", "res://i18n/puzzle.en.translation", "res://i18n/puzzle.ru.translation", "res://i18n/puzzle.es.translation", "res://i18n/puzzle.zh.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.08, 0.2, 1)
